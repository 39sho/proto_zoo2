VITE_API_URL=http://localhost:8080

# Optional. Leave empty to run as a single local "dev" user (no Clerk needed).
#
# To enable Clerk sign-in, uncomment BOTH lines below (the secret key must NOT
# be prefixed with VITE_). The server must also set CLERK_ISSUER — see
# server/.env.example.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
