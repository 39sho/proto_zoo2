#[Data]
DATABASE_URL=postgresql://postgres:password@localhost:54321/electric

#[API]
BIND_ADDR=0.0.0.0:8080
CORS_ORIGIN=http://localhost:3000

#[Electric]
ELECTRIC_URL=http://localhost:3001/v1/shape
# Must match ELECTRIC_SECRET in the root .env / docker-compose.yml when enabled.
# ELECTRIC_SECRET=local-electric-secret

#[Auth: OIDC]
# Provider-agnostic. Point these at any OIDC provider's issuer (Keycloak,
# Zitadel, Kanidm, Authentik, Ory, Clerk, ...). Leave OIDC_ISSUER unset to run
# in DEV AUTH mode (every request is one local user).
# OIDC_ISSUER=https://id.example.com/realms/acme
# OIDC_JWKS_URL=https://id.example.com/realms/acme/protocol/openid-connect/certs
# OIDC_AUDIENCE=
# DEV_EXTERNAL_ID=dev-user
# CLERK_ISSUER=...   # legacy aliases OIDC_* still accepts CLERK_*
